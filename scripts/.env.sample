# Copy to .env and fill in. Get the endpoint from your Foundry project's Home page.
AZURE_AI_PROJECT_ENDPOINT=https://aif-agentlab-dev-cac-ac01.services.ai.azure.com/api/projects/proj-agentlab-dev-cac-ac01

# Agent and models (deployment names from the setup guide)
AGENT_NAME=claims-coverage-agent
AGENT_MODEL=gpt-chat-latest
JUDGE_MODEL=gpt-chat-latest

# Optional: a project storage connection for eval datasets. Leave empty for the workshop.
STORAGE_CONNECTION_NAME=

# Optional: name of a guardrail created in Build > Guardrails, attached to new agent versions.
GUARDRAIL_NAME=
